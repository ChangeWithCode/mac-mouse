<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>Glide</string>
    <key>CFBundleDisplayName</key>
    <string>Glide</string>
    <key>CFBundleIdentifier</key>
    <string>com.glide.app</string>
    <key>CFBundleExecutable</key>
    <string>Glide</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <!-- Placeholders. Scripts/build-app.sh stamps the real numbers into the
         bundle's copy of this file from the top-level VERSION file, so the
         version lives in exactly one place. A bundle still reading 0.0.0 was
         assembled by hand rather than by the script. -->
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundleVersion</key>
    <string>0</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <!-- Menu-bar app: no Dock icon, no app-switcher entry. The settings window
         is opened from the menu bar rather than being the app's main presence. -->
    <key>LSUIElement</key>
    <true/>
    <!-- IOHIDManager reads input reports to tell one mouse from another. macOS
         gates that behind Input Monitoring and denies it outright when the
         bundle carries no usage string, which silently disables per-device
         profiles. -->
    <key>NSInputMonitoringUsageDescription</key>
    <string>Glide identifies which mouse an event came from so each device can keep its own settings.</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
</dict>
</plist>
